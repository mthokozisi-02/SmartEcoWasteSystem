{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_HOST;Port=3306;Database=smartecowastedb;User=smarteco_app;Password=YOUR_STRONG_PASSWORD;"
  },
  "AppSettings": {
    "Token": "YOUR_STRONG_RANDOM_JWT_SIGNING_KEY_MIN_32_CHARS",
    "Issuer": "EcoWasteApi",
    "Audience": "EcoWasteClient",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "ClientBaseUrl": "https://app.smartecowaste.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.smartecowaste.com"
    ]
  },
  "SeedDemoData": false,
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@example.com",
    "Password": "YOUR_GOOGLE_APP_PASSWORD",
    "FromAddress": "your-email@example.com",
    "SenderName": "Smart Eco Waste System",
    "EnableSsl": true
  }
}
